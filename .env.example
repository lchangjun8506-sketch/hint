# Vercel 프로젝트 > Settings > Environment Variables 에 같은 이름으로 등록하세요.
# 실제 값은 이 파일이나 저장소에 넣지 마세요.

# 스프레드시트 주소의 /d/ 와 /edit 사이 값
SHEET_ID=

# 서비스 계정 JSON 키의 client_email
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# 서비스 계정 JSON 키의 private_key (줄바꿈은 \n 으로 그대로)
GOOGLE_PRIVATE_KEY=

# 선택: 탭 이름을 바꾸고 싶을 때 (기본값 Logs / Exercises)
# LOGS_TAB=Logs
# EXERCISES_TAB=Exercises
