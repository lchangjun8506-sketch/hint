        // Navigation Tab Switcher
        function switchTab(tabName) {
            document.getElementById('section-input').classList.add('hidden');
            document.getElementById('section-list').classList.add('hidden');
            document.getElementById('section-summary').classList.add('hidden');

            document.querySelectorAll('.nav-tab').forEach(btn => {
                btn.classList.remove('text-indigo-600', 'font-bold');
                btn.classList.add('text-slate-400', 'font-medium');
            });

            document.getElementById(`section-${tabName}`).classList.remove('hidden');
            const activeNavBtn = document.getElementById(`tab-btn-${tabName}`);
            activeNavBtn.classList.remove('text-slate-400', 'font-medium');
            activeNavBtn.classList.add('text-indigo-600', 'font-bold');

            if (tabName === 'summary') {
                renderSummaryDashboard();
            } else if (tabName === 'list') {
                renderLogList();
            }
