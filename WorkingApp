<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>FITTER</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @import url('https://cdn.jsdelivr.net/gh/orioncactus/pretendard/dist/web/static/pretendard.css');
        body {
            font-family: 'Pretendard', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
            background-color: #f1f5f9;
            -webkit-tap-highlight-color: transparent;
        }
        .btn-active {
            transition: all 0.15s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .btn-active:active {
            transform: scale(0.96);
            opacity: 0.9;
        }
        .glass-card {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(12px);
        }
        .custom-scrollbar::-webkit-scrollbar {
            height: 4px;
            width: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 9999px;
        }
    </style>
</head>
<body class="text-slate-800 min-h-screen flex flex-col pb-24 selection:bg-indigo-500 selection:text-white">

    <!-- Top Header -->
    <header class="bg-slate-900 text-white sticky top-0 z-40 shadow-md">
        <div class="max-w-md mx-auto px-4 py-3.5 flex items-center justify-between">
            <div class="flex items-center space-x-2.5">
                <div class="bg-indigo-600 text-white p-2 rounded-xl font-bold text-base w-9 h-9 flex items-center justify-center shadow-sm">
                    <i class="fa-solid fa-dumbbell"></i>
                </div>
                <div>
                    <h1 class="font-bold text-lg leading-tight tracking-wide">FITTER</h1>
                </div>
            </div>
            <!-- Loading Indicator -->
            <div id="global-loading" class="hidden">
                <i class="fa-solid fa-circle-notch fa-spin text-indigo-400 text-xl"></i>
            </div>
        </div>
    </header>

    <!-- Main Content Container -->
    <main class="max-w-md mx-auto w-full px-4 pt-4 flex-1">

        <!-- 1. 입력 화면 (Input Section) -->
        <section id="section-input" class="space-y-4">
            
            <!-- Quick Rest Timer Bar -->
            <div class="bg-indigo-900 text-white p-3.5 rounded-2xl shadow-lg flex items-center justify-between">
                <div class="flex items-center space-x-2">
                    <i class="fa-solid fa-stopwatch text-indigo-300 text-lg"></i>
                    <span class="text-xs font-semibold text-indigo-200">휴식 타이머</span>
                    <span id="timer-display" class="font-bold text-base text-emerald-400 tracking-wide">00:00</span>
                </div>
                <div class="flex space-x-1.5">
                    <button onclick="startRestTimer(60)" class="bg-indigo-800 hover:bg-indigo-700 active:bg-indigo-600 px-2.5 py-1 rounded-xl text-xs font-medium border border-indigo-700/50 btn-active">60초</button>
                    <button onclick="startRestTimer(90)" class="bg-indigo-800 hover:bg-indigo-700 active:bg-indigo-600 px-2.5 py-1 rounded-xl text-xs font-medium border border-indigo-700/50 btn-active">90초</button>
                    <button onclick="startRestTimer(120)" class="bg-indigo-800 hover:bg-indigo-700 active:bg-indigo-600 px-2.5 py-1 rounded-xl text-xs font-medium border border-indigo-700/50 btn-active">2분</button>
                    <button onclick="resetRestTimer()" class="bg-slate-800 hover:bg-slate-700 px-2 py-1 rounded-xl text-xs text-slate-400 btn-active"><i class="fa-solid fa-rotate-right"></i></button>
                </div>
            </div>

            <!-- Main Input Form Card -->
            <div class="bg-white rounded-3xl p-5 shadow-sm border border-slate-200/80 space-y-4">
                <div class="flex items-center justify-between pb-2 border-b border-slate-100">
                    <h2 id="form-title-text" class="font-bold text-slate-800 flex items-center text-base">
                        <i class="fa-solid fa-pen-to-square text-indigo-600 mr-2"></i>운동 일지 작성
                    </h2>
                    <input type="date" id="input-date" class="bg-slate-50 border border-slate-200 text-slate-700 text-xs rounded-xl px-2.5 py-1.5 focus:outline-none focus:ring-2 focus:ring-indigo-500 font-medium">
                </div>

                <!-- Routine Selector -->
                <div>
                    <label class="block text-xs font-bold text-slate-500 mb-1.5">분할 루틴</label>
                    <div class="grid grid-cols-4 gap-1.5" id="routine-buttons">
                        <button type="button" onclick="selectRoutine('가슴·삼두')" class="routine-btn bg-indigo-600 text-white py-2.5 px-1 rounded-2xl text-xs font-bold text-center shadow-sm btn-active" data-value="가슴·삼두">가슴·삼두</button>
                        <button type="button" onclick="selectRoutine('등·이두')" class="routine-btn bg-slate-100 text-slate-600 py-2.5 px-1 rounded-2xl text-xs font-semibold text-center border border-slate-200 btn-active" data-value="등·이두">등·이두</button>
                        <button type="button" onclick="selectRoutine('어깨')" class="routine-btn bg-slate-100 text-slate-600 py-2.5 px-1 rounded-2xl text-xs font-semibold text-center border border-slate-200 btn-active" data-value="어깨">어깨</button>
                        <button type="button" onclick="selectRoutine('하체')" class="routine-btn bg-slate-100 text-slate-600 py-2.5 px-1 rounded-2xl text-xs font-semibold text-center border border-slate-200 btn-active" data-value="하체">하체</button>
                    </div>
                </div>

                <!-- Frequent Exercise Chips -->
                <div>
                    <label class="block text-xs font-bold text-slate-500 mb-1.5">최근 수행 운동 (빠른 선택)</label>
                    <div id="quick-exercise-chips" class="flex flex-wrap gap-1.5">
                        <!-- Dynamically filled -->
                    </div>
                </div>

                <!-- Exercise Selector & Custom Add Button -->
                <div>
                    <div class="flex items-center justify-between mb-1.5">
                        <label class="block text-xs font-bold text-slate-500">운동 종목</label>
                        <div class="flex items-center space-x-2">
                            <button type="button" onclick="openAddExerciseModal()" class="text-xs font-bold text-indigo-600 hover:text-indigo-800 flex items-center bg-indigo-50 px-2 py-0.5 rounded-lg border border-indigo-100 btn-active">
                                <i class="fa-solid fa-plus mr-1 text-[10px]"></i>종목 추가
                            </button>
                            <span class="text-[11px] font-medium text-amber-700 bg-amber-50 px-2 py-0.5 rounded-md border border-amber-200">
                                <i class="fa-solid fa-circle-info mr-1"></i>덤벨 한 손 기준
                            </span>
                        </div>
                    </div>
                    <select id="input-exercise" onchange="onExerciseChange()" class="w-full bg-slate-50 border border-slate-200 text-slate-800 text-sm rounded-2xl p-3 focus:outline-none focus:ring-2 focus:ring-indigo-500 font-semibold">
                        <!-- Dynamically populated -->
                    </select>
                </div>

                <!-- Smart Overload Coaching Tip Banner -->
                <div id="coaching-tip-box" class="hidden bg-indigo-50/90 border border-indigo-200/80 rounded-2xl p-3 flex items-start space-x-2.5">
                    <div class="bg-indigo-600 text-white p-1.5 rounded-xl text-xs mt-0.5">
                        <i class="fa-solid fa-lightbulb"></i>
                    </div>
                    <div class="flex-1">
                        <div class="text-xs font-bold text-indigo-950" id="coaching-tip-title">점진적 과부하 가이드</div>
                        <p class="text-[11px] text-indigo-800 leading-snug mt-0.5" id="coaching-tip-desc">지난 기록을 바탕으로 추천 무게를 계산합니다.</p>
                    </div>
                </div>

                <!-- Real-time Volume & 1RM Stats -->
                <div class="bg-slate-900 text-white rounded-2xl p-3.5 flex items-center justify-around shadow-inner">
                    <div class="text-center">
                        <div class="text-[10px] text-slate-400 font-semibold uppercase tracking-wider">오늘 총 볼륨</div>
                        <div id="stat-total-volume" class="text-base font-extrabold text-indigo-400 mt-0.5">0 kg</div>
                    </div>
                    <div class="h-6 w-px bg-slate-800"></div>
                    <div class="text-center">
                        <div class="text-[10px] text-slate-400 font-semibold uppercase tracking-wider">추정 1RM</div>
                        <div id="stat-estimated-1rm" class="text-base font-extrabold text-emerald-400 mt-0.5">0 kg</div>
                    </div>
                </div>

                <!-- Set Records Container -->
                <div class="space-y-2 pt-1">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold text-slate-600">세트별 수행 기록</span>
                        <div class="flex space-x-2">
                            <button type="button" onclick="loadLastRecordSets()" class="text-xs text-indigo-600 hover:text-indigo-800 font-bold bg-indigo-50 px-2.5 py-1 rounded-xl border border-indigo-100 btn-active">
                                <i class="fa-solid fa-clock-rotate-left mr-1"></i>지난 기록 가져오기
                            </button>
                            <button type="button" onclick="copyFirstSetToAll()" class="text-xs text-slate-600 hover:text-slate-800 font-semibold bg-slate-100 px-2 py-1 rounded-xl border border-slate-200 btn-active">
                                1세트 복사
                            </button>
                        </div>
                    </div>

                    <div id="sets-container" class="space-y-2">
                        <!-- Dynamic Set Rows Added Here -->
                    </div>

                    <button type="button" onclick="addSetRow()" class="w-full py-2.5 bg-slate-50 hover:bg-slate-100 text-slate-600 border border-dashed border-slate-300 rounded-2xl text-xs font-bold flex items-center justify-center btn-active">
                        <i class="fa-solid fa-plus mr-1.5"></i>세트 추가하기
                    </button>
                </div>

                <!-- Condition Memo Input -->
                <div>
                    <label class="block text-xs font-bold text-slate-500 mb-1">컨디션 / 메모 (선택)</label>
                    <input type="text" id="input-memo" placeholder="예: 어깨 통증 약간 있음, 컨디션 최고" class="w-full bg-slate-50 border border-slate-200 text-slate-700 text-xs rounded-2xl p-2.5 focus:outline-none focus:ring-2 focus:ring-indigo-500">
                </div>

                <!-- Save & Cancel Edit Button Area -->
                <div id="form-btn-container" class="space-y-2">
                    <button type="button" onclick="saveRecord()" id="save-btn" class="w-full py-3.5 bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white font-bold rounded-2xl shadow-md text-sm transition-all btn-active flex items-center justify-center">
                        <i class="fa-solid fa-floppy-disk mr-2"></i>운동 일지 저장하기
                    </button>
                </div>
            </div>
        </section>

        <!-- 2. 목록 화면 (List Section) -->
        <section id="section-list" class="hidden space-y-3">
            <div class="bg-white rounded-3xl p-4 shadow-sm border border-slate-200/80 space-y-3">
                <div class="flex items-center justify-between">
                    <h2 class="font-bold text-slate-800 text-base"><i class="fa-solid fa-list-check text-indigo-600 mr-2"></i>운동 일지 목록</h2>
                    <span id="log-count-badge" class="text-xs font-bold bg-indigo-100 text-indigo-800 px-2.5 py-0.5 rounded-full">총 0개</span>
                </div>
                <!-- Search Box -->
                <div class="relative">
                    <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-3 text-slate-400 text-xs"></i>
                    <input type="text" id="search-keyword" onkeyup="filterLogs()" placeholder="종목명, 루틴, 날짜 검색..." class="w-full pl-9 pr-3 py-2 bg-slate-50 border border-slate-200 rounded-2xl text-xs text-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-500">
                </div>
            </div>

            <!-- Log Cards List Container -->
            <div id="log-cards-container" class="space-y-2.5">
                <!-- Dynamically filled with log cards -->
            </div>
        </section>

        <!-- 3. 요약 화면 (Summary Section) -->
        <section id="section-summary" class="hidden space-y-4">
            
            <!-- Summary Top Cards -->
            <div class="grid grid-cols-3 gap-2">
                <div class="bg-white p-3 rounded-2xl shadow-sm border border-slate-200/80 text-center">
                    <div class="text-[10px] font-semibold text-slate-400">당일 기록률</div>
                    <div id="summary-stat-1" class="text-base font-extrabold text-slate-800 mt-1">100%</div>
                </div>
                <div class="bg-white p-3 rounded-2xl shadow-sm border border-slate-200/80 text-center">
                    <div class="text-[10px] font-semibold text-slate-400">진전 종목 비율</div>
                    <div id="summary-stat-2" class="text-base font-extrabold text-indigo-600 mt-1">73.1%</div>
                </div>
                <div class="bg-white p-3 rounded-2xl shadow-sm border border-slate-200/80 text-center">
                    <div class="text-[10px] font-semibold text-slate-400">연속 정체 종목</div>
                    <div id="summary-stat-3" class="text-base font-extrabold text-rose-500 mt-1">0개</div>
                </div>
            </div>

            <!-- Routine Filter Tab -->
            <div class="flex bg-slate-200/70 p-1 rounded-2xl space-x-1" id="summary-filter-tabs">
                <button onclick="filterSummaryRoutine('전체')" class="summary-tab-btn flex-1 py-1.5 text-xs font-bold rounded-xl bg-white text-indigo-600 shadow-sm" data-value="전체">전체</button>
                <button onclick="filterSummaryRoutine('가슴·삼두')" class="summary-tab-btn flex-1 py-1.5 text-xs font-semibold rounded-xl text-slate-600" data-value="가슴·삼두">가슴</button>
                <button onclick="filterSummaryRoutine('등·이두')" class="summary-tab-btn flex-1 py-1.5 text-xs font-semibold rounded-xl text-slate-600" data-value="등·이두">등</button>
                <button onclick="filterSummaryRoutine('어깨')" class="summary-tab-btn flex-1 py-1.5 text-xs font-semibold rounded-xl text-slate-600" data-value="어깨">어깨</button>
                <button onclick="filterSummaryRoutine('하체')" class="summary-tab-btn flex-1 py-1.5 text-xs font-semibold rounded-xl text-slate-600" data-value="하체">하체</button>
            </div>

            <!-- Overload Analysis Cards -->
            <div id="overload-analysis-container" class="space-y-3">
                <!-- Dynamically filled overload analysis cards -->
            </div>
        </section>

    </main>

    <!-- Modal: Add Custom Exercise -->
    <div id="add-exercise-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-white rounded-3xl max-w-xs w-full p-5 space-y-4 shadow-2xl border border-slate-100">
            <div class="flex items-center justify-between pb-2 border-b border-slate-100">
                <h3 class="font-bold text-slate-800 text-sm flex items-center">
                    <i class="fa-solid fa-plus-circle text-indigo-600 mr-2"></i>운동 종목 직접 추가
                </h3>
                <button onclick="closeAddExerciseModal()" class="text-slate-400 hover:text-slate-600 text-sm"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-500 mb-1">분할 루틴 선택</label>
                <select id="modal-routine-select" class="w-full bg-slate-50 border border-slate-200 text-slate-800 text-xs rounded-xl p-2.5 font-bold focus:outline-none focus:ring-2 focus:ring-indigo-500">
                    <option value="가슴·삼두">가슴·삼두</option>
                    <option value="등·이두">등·이두</option>
                    <option value="어깨">어깨</option>
                    <option value="하체">하체</option>
                </select>
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-500 mb-1">새 운동 종목명</label>
                <input type="text" id="modal-exercise-name" placeholder="예: 체스트 플라이 머신" class="w-full bg-slate-50 border border-slate-200 text-slate-800 text-xs rounded-xl p-2.5 font-semibold focus:outline-none focus:ring-2 focus:ring-indigo-500">
            </div>
            <div class="flex space-x-2 pt-1">
                <button onclick="closeAddExerciseModal()" class="flex-1 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-xl text-xs font-bold btn-active">취소</button>
                <button onclick="saveCustomExercise()" class="flex-1 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl text-xs font-bold btn-active">등록하기</button>
            </div>
        </div>
    </div>

    <!-- Bottom Navigation Bar -->
    <nav class="fixed bottom-0 left-0 right-0 bg-white/95 backdrop-blur-md border-t border-slate-200 z-50">
        <div class="max-w-md mx-auto grid grid-cols-3 h-16">
            <button onclick="switchTab('input')" id="tab-btn-input" class="nav-tab flex flex-col items-center justify-center text-indigo-600 font-bold">
                <i class="fa-solid fa-pen-to-square text-lg mb-1"></i>
                <span class="text-[10px]">일지 작성</span>
            </button>
            <button onclick="switchTab('list')" id="tab-btn-list" class="nav-tab flex flex-col items-center justify-center text-slate-400 font-medium hover:text-slate-600">
                <i class="fa-solid fa-list-ul text-lg mb-1"></i>
                <span class="text-[10px]">운동 일지</span>
            </button>
            <button onclick="switchTab('summary')" id="tab-btn-summary" class="nav-tab flex flex-col items-center justify-center text-slate-400 font-medium hover:text-slate-600">
                <i class="fa-solid fa-chart-line text-lg mb-1"></i>
                <span class="text-[10px]">진전 대시보드</span>
            </button>
        </div>
    </nav>

    <!-- App Logic Script -->
    <script>
        // Preset Exercises by Routine
        const ROUTINE_EXERCISES = {
            '가슴·삼두': ['벤치 프레스', '덤벨 벤치 프레스', '인클라인 벤치 프레스', '인클라인 덤벨 프레스', '디클라인 벤치 프레스', '체스트 프레스 머신', '덤벨 플라이', '펙덱 플라이', '케이블 크로스 오버', '딥스', '삼두 케이블 푸쉬 다운', '라잉 트라이셉스 익스텐션', '덤벨 오버헤드 트라이셉스 익스텐션', '덤벨 킥백'],
            '등·이두': ['컨벤셔널 데드리프트', '루마니안 데드리프트', '바벨 로우', '덤벨 로우', '랫 풀 다운', '맥그립 랫 풀 다운', '시티드 케이블 로우', 'T바 로우', '암 풀 다운', '풀업', '바벨 컬', '덤벨 컬', '해머 컬', '인클라인 덤벨 컬', '프리처 컬'],
            '어깨': ['오버헤드 프레스', '덤벨 숄더 프레스', '스미스머신 숄더 프레스', '사이드 레터럴 레이즈', '케이블 사이드 레터럴 레이즈', '프론트 레이즈', '벤트오버 레터럴 레이즈', '페이스 풀', '슈러그'],
            '하체': ['스쿼트', '스미스머신 스쿼트', '프론트 스쿼트', '레그 프레스', '파워 레그 프레스', '레그 익스텐션', '레그 컬', '스티프 레그 데드리프트', '힙 어덕션', '힙 어브덕션', '힙 쓰러스터', '카프 레이즈', '런지']
        };

        // State Variables
        let currentRoutine = '가슴·삼두';
        let customExercises = [];
        let allLogs = [];
        let timerInterval = null;
        let timerSeconds = 0;
        let summaryRoutineFilter = '전체';
        let editingLogId = null;

        // Sample Fallback Data
        const SAMPLE_LOGS = [
            { id: 'LOG_1013_1', date: '2026-10-13', routine: '하체', exercise: '스쿼트', sets: [{weight: 80, reps: 10}, {weight: 80, reps: 10}, {weight: 80, reps: 8}], createdAt: '2026-10-13 21:00:00' },
            { id: 'LOG_1013_2', date: '2026-10-13', routine: '하체', exercise: '레그 프레스', sets: [{weight: 120, reps: 12}, {weight: 120, reps: 12}, {weight: 120, reps: 10}], createdAt: '2026-10-13 21:30:00' },
            { id: 'LOG_1012_1', date: '2026-10-12', routine: '가슴·삼두', exercise: '벤치 프레스', sets: [{weight: 60, reps: 10}, {weight: 60, reps: 10}, {weight: 60, reps: 9, drops: [{weight: 40, reps: 4}]}], createdAt: '2026-10-12 20:00:00' },
            { id: 'LOG_1012_2', date: '2026-10-12', routine: '가슴·삼두', exercise: '덤벨 벤치 프레스', sets: [{weight: 20, reps: 10}, {weight: 20, reps: 10}, {weight: 20, reps: 8}], createdAt: '2026-10-12 20:30:00' },
            { id: 'LOG_1010_1', date: '2026-10-10', routine: '등·이두', exercise: '랫 풀 다운', sets: [{weight: 45, reps: 12}, {weight: 45, reps: 12}, {weight: 45, reps: 10}], createdAt: '2026-10-10 19:30:00' },
            { id: 'LOG_1008_1', date: '2026-10-08', routine: '어깨', exercise: '사이드 레터럴 레이즈', sets: [{weight: 8, reps: 15}, {weight: 8, reps: 15}, {weight: 8, reps: 12}], createdAt: '2026-10-08 21:00:00' }
