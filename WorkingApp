        // Custom Exercise Management
        function openAddExerciseModal() {
            document.getElementById('modal-routine-select').value = currentRoutine;
            document.getElementById('modal-exercise-name').value = '';
            document.getElementById('add-exercise-modal').classList.remove('hidden');
        }

        function closeAddExerciseModal() {
            document.getElementById('add-exercise-modal').classList.add('hidden');
        }

        function saveCustomExercise() {
            const routine = document.getElementById('modal-routine-select').value;
            const exName = document.getElementById('modal-exercise-name').value.trim();

            if (!exName) return alert('종목명을 입력하세요.');

            customExercises.push({ routine: routine, exercise: exName });
            try {
                localStorage.setItem('fitter_custom_exs', JSON.stringify(customExercises));
            } catch(e) {}

            closeAddExerciseModal();
            selectRoutine(routine);
            document.getElementById('input-exercise').value = exName;
            onExerciseChange();

            if (typeof google !== 'undefined' && google.script && google.script.run) {
                google.script.run.addCustomExercise(routine, exName);
            }
        }

        function fetchCustomExercises() {
            try {
                const local = localStorage.getItem('fitter_custom_exs');
                if (local) customExercises = JSON.parse(local);
            } catch(e) {}

            if (typeof google !== 'undefined' && google.script && google.script.run) {
                google.script.run.withSuccessHandler(list => {
                    if (list && list.length > 0) {
                        customExercises = list;
                        updateExerciseDropdown();
                    }
                }).getCustomExercises();
            } else {
                updateExerciseDropdown();
            }
        }

        // Fetch Logs & Render
        function fetchLogs() {
            showLoading(true);
            if (typeof google !== 'undefined' && google.script && google.script.run) {
                google.script.run
                    .withSuccessHandler(data => {
                        showLoading(false);
                        allLogs = data;
                        renderLogList();
                    })
                    .withFailureHandler(err => {
                        showLoading(false);
                        allLogs = SAMPLE_LOGS;
                        renderLogList();
                    })
                    .getLogs();
            } else {
                setTimeout(() => {
                    showLoading(false);
                    allLogs = SAMPLE_LOGS;
                    renderLogList();
                }, 300);
            }
        }

        function renderLogList() {
            const container = document.getElementById('log-cards-container');
            const keyword = document.getElementById('search-keyword')?.value?.toLowerCase() || '';

            const filtered = allLogs.filter(l => 
                l.exercise.toLowerCase().includes(keyword) || 
                l.routine.toLowerCase().includes(keyword) || 
                l.date.includes(keyword)
            );

            document.getElementById('log-count-badge').textContent = `총 ${filtered.length}개`;
            container.innerHTML = '';

            if (filtered.length === 0) {
                container.innerHTML = `<div class="text-center py-10 text-xs text-slate-400 font-semibold">저장된 운동 일지가 없습니다.</div>`;
                return;
            }

            filtered.forEach(log => {
                const card = document.createElement('div');
                card.className = 'bg-white rounded-3xl p-4 shadow-sm border border-slate-200/80 space-y-2.5';

                const setsText = log.sets.map((s, idx) => {
                    let text = `${idx+1}세트: ${s.weight}kg × ${s.reps}회`;
                    if (s.drops) {
                        s.drops.forEach(d => {
                            text += ` <span class="text-amber-700 text-[10px]">(드롭 ${d.weight}kg×${d.reps}회)</span>`;
                        });
                    }
                    return `<span class="inline-block bg-slate-100 text-slate-700 text-[11px] font-bold px-2 py-0.5 rounded-lg border border-slate-200/60 mr-1 mb-1">${text}</span>`;
                }).join('');

                card.innerHTML = `
                    <div class="flex items-center justify-between pb-2 border-b border-slate-100">
                        <div class="flex items-center space-x-2">
                            <span class="text-xs font-bold text-indigo-600 bg-indigo-50 px-2.5 py-1 rounded-xl">${log.routine}</span>
                            <span class="font-bold text-sm text-slate-800">${log.exercise}</span>
                        </div>
                        <div class="flex items-center space-x-2">
                            <span class="text-[11px] text-slate-400 font-medium">${log.date}</span>
                            <button onclick="editRecord('${log.id}')" class="text-slate-300 hover:text-indigo-600 p-1 btn-active" title="수정"><i class="fa-solid fa-pen text-xs"></i></button>
                            <button onclick="deleteRecord('${log.id}')" class="text-slate-300 hover:text-rose-500 p-1 btn-active" title="삭제"><i class="fa-solid fa-trash-can text-xs"></i></button>
                        </div>
                    </div>
                    <div class="flex flex-wrap pt-0.5">${setsText}</div>
                    ${log.memo ? `<div class="text-[11px] text-slate-500 bg-slate-50 p-2 rounded-xl border border-slate-100"><i class="fa-solid fa-comment-dots mr-1.5 text-indigo-400"></i>${log.memo}</div>` : ''}
                `;
                container.appendChild(card);
            });
        }

        function filterLogs() {
            renderLogList();
        }

        function deleteRecord(id) {
            if (!confirm('해당 운동 일지를 삭제하시겠습니까?')) return;
            showLoading(true);

            if (typeof google !== 'undefined' && google.script && google.script.run) {
                google.script.run
                    .withSuccessHandler(res => {
                        showLoading(false);
                        fetchLogs();
                    })
                    .deleteLog(id);
            } else {
                setTimeout(() => {
                    showLoading(false);
                    allLogs = allLogs.filter(l => l.id !== id);
                    renderLogList();
                }, 300);
            }
        }

        // Summary Dashboard Renderer
        function renderSummaryDashboard() {
            const container = document.getElementById('overload-analysis-container');
            container.innerHTML = '';

            const grouped = {};
            allLogs.forEach(l => {
                if (summaryRoutineFilter !== '전체' && l.routine !== summaryRoutineFilter) return;
                if (!grouped[l.exercise]) grouped[l.exercise] = [];
                grouped[l.exercise].push(l);
            });

            const keys = Object.keys(grouped);

            if (keys.length === 0) {
                container.innerHTML = `<div class="text-center py-10 text-xs text-slate-400 font-semibold">분석할 일지 데이터가 없습니다.</div>`;
                return;
            }

            let totalProgressCount = 0;
            let totalStagnantCount = 0;

            keys.forEach(ex => {
                const history = grouped[ex];
                const latest = history[0];
                const prev = history[1];

                let statusBadge = `<span class="bg-slate-100 text-slate-600 text-[10px] font-bold px-2 py-0.5 rounded-lg">기록 부족</span>`;

                if (prev) {
                    const latestMaxW = Math.max(...latest.sets.map(s => s.weight || 0));
                    const latestMaxR = Math.max(...latest.sets.map(s => s.reps || 0));
                    const prevMaxW = Math.max(...prev.sets.map(s => s.weight || 0));
                    const prevMaxR = Math.max(...prev.sets.map(s => s.reps || 0));

                    if (latestMaxW > prevMaxW || (latestMaxW === prevMaxW && latestMaxR > prevMaxR)) {
                        statusBadge = `<span class="bg-emerald-50 text-emerald-700 border border-emerald-200 text-[10px] font-bold px-2 py-0.5 rounded-lg"><i class="fa-solid fa-arrow-trend-up mr-1"></i>과부하 진전</span>`;
                        totalProgressCount++;
                    } else if (history.length >= 3 && history[0].sets[0]?.weight === history[1].sets[0]?.weight && history[1].sets[0]?.weight === history[2].sets[0]?.weight) {
                        statusBadge = `<span class="bg-rose-50 text-rose-700 border border-rose-200 text-[10px] font-bold px-2 py-0.5 rounded-lg"><i class="fa-solid fa-triangle-exclamation mr-1"></i>연속 정체</span>`;
                        totalStagnantCount++;
                    } else {
                        statusBadge = `<span class="bg-amber-50 text-amber-700 border border-amber-200 text-[10px] font-bold px-2 py-0.5 rounded-lg">무게 유지</span>`;
                    }
                }

                const card = document.createElement('div');
                card.className = 'bg-white rounded-3xl p-4 shadow-sm border border-slate-200/80 space-y-2';

                const latestSetsStr = latest.sets.map(s => {
                    let str = `${s.weight}kg×${s.reps}회`;
                    if (s.drops) {
                        s.drops.forEach(d => { str += `(드롭${d.weight}kg×${d.reps}회)`; });
                    }
                    return str;
                }).join(', ');

                card.innerHTML = `
                    <div class="flex items-center justify-between">
                        <div class="flex items-center space-x-2">
                            <span class="text-xs font-bold text-slate-800">${ex}</span>
                            <span class="text-[10px] font-medium text-slate-400">(${latest.routine})</span>
                        </div>
                        ${statusBadge}
                    </div>
                    <div class="text-xs text-slate-600 bg-slate-50 p-2.5 rounded-xl border border-slate-100 flex items-center justify-between">
                        <span class="font-semibold text-slate-500">최근 수행:</span>
                        <span class="font-bold text-slate-800">${latestSetsStr}</span>
                    </div>
                `;
                container.appendChild(card);
            });

            const progressRatio = keys.length > 0 ? Math.round((totalProgressCount / keys.length) * 100) : 0;
            document.getElementById('summary-stat-2').textContent = `${progressRatio}%`;
            document.getElementById('summary-stat-3').textContent = `${totalStagnantCount}개`;
        }

        function filterSummaryRoutine(routine) {
            summaryRoutineFilter = routine;
            document.querySelectorAll('.summary-tab-btn').forEach(btn => {
                if (btn.getAttribute('data-value') === routine) {
                    btn.className = 'summary-tab-btn flex-1 py-1.5 text-xs font-bold rounded-xl bg-white text-indigo-600 shadow-sm';
                } else {
                    btn.className = 'summary-tab-btn flex-1 py-1.5 text-xs font-semibold rounded-xl text-slate-600';
                }
            });
            renderSummaryDashboard();
        }

        function showLoading(isLoading) {
            const spinner = document.getElementById('global-loading');
            if (isLoading) spinner.classList.remove('hidden');
            else spinner.classList.add('hidden');
        }
    </script>
</body>
</html>
