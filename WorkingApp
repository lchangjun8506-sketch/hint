        // Routine Selector Logic
        function selectRoutine(routine) {
            currentRoutine = routine;
            document.querySelectorAll('.routine-btn').forEach(btn => {
                if (btn.getAttribute('data-value') === routine) {
                    btn.className = 'routine-btn bg-indigo-600 text-white py-2.5 px-1 rounded-2xl text-xs font-bold text-center shadow-sm btn-active';
                } else {
                    btn.className = 'routine-btn bg-slate-100 text-slate-600 py-2.5 px-1 rounded-2xl text-xs font-semibold text-center border border-slate-200 btn-active';
                }
            });
            updateExerciseDropdown();
        }

        // Exercise Dropdown & Quick Chips Update
        function updateExerciseDropdown() {
            const exerciseSelect = document.getElementById('input-exercise');
            exerciseSelect.innerHTML = '';

            const presetList = ROUTINE_EXERCISES[currentRoutine] || [];
            const userCustomList = customExercises.filter(item => item.routine === currentRoutine).map(item => item.exercise);
            const fullList = [...new Set([...presetList, ...userCustomList])];

            fullList.forEach(ex => {
                const opt = document.createElement('option');
                opt.value = ex;
                opt.textContent = ex;
                exerciseSelect.appendChild(opt);
            });

            // Update Quick Pick Chips
            const recentExs = getRecentExercisesByRoutine(currentRoutine);
            const chipsContainer = document.getElementById('quick-exercise-chips');
            chipsContainer.innerHTML = '';

            recentExs.forEach(ex => {
                const chip = document.createElement('button');
                chip.type = 'button';
                chip.className = 'bg-indigo-50 hover:bg-indigo-100 text-indigo-700 text-[11px] font-bold px-2.5 py-1 rounded-xl border border-indigo-200/60 btn-active';
                chip.innerHTML = `<i class="fa-solid fa-bolt mr-1 text-indigo-500"></i>${ex}`;
                chip.onclick = () => {
                    exerciseSelect.value = ex;
                    onExerciseChange();
                };
                chipsContainer.appendChild(chip);
            });

            onExerciseChange();
        }

        function getRecentExercisesByRoutine(routine) {
            const filtered = allLogs.filter(l => l.routine === routine);
            const uniqueExs = [...new Set(filtered.map(l => l.exercise))];
            if (uniqueExs.length > 0) return uniqueExs.slice(0, 3);
            return (ROUTINE_EXERCISES[routine] || []).slice(0, 3);
        }

        function onExerciseChange() {
            calculateCoachingTip();
            calculateRealtimeStats();
        }

        // Set Row & Drop Set Logic
        function addSetRow(weight = '', reps = '', drops = null) {
            const container = document.getElementById('sets-container');
            const setIndex = container.children.length + 1;

            const row = document.createElement('div');
            row.className = 'set-row bg-slate-50 p-2.5 rounded-2xl border border-slate-200/80 space-y-2';
            row.innerHTML = `
                <div class="flex items-center space-x-2">
                    <span class="set-num font-extrabold text-xs text-indigo-600 w-12 text-center bg-indigo-50 py-2 rounded-xl shrink-0">${setIndex}세트</span>
                    <div class="flex-1 flex items-center space-x-1">
                        <input type="number" step="0.5" placeholder="무게" value="${weight}" oninput="calculateRealtimeStats()" class="set-weight w-full bg-white border border-slate-200 rounded-xl px-2 py-1.5 text-xs text-center font-bold focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                        <span class="text-[10px] font-bold text-slate-400 shrink-0">kg</span>
                    </div>
                    <div class="flex-1 flex items-center space-x-1">
                        <input type="number" placeholder="횟수" value="${reps}" oninput="calculateRealtimeStats()" class="set-reps w-full bg-white border border-slate-200 rounded-xl px-2 py-1.5 text-xs text-center font-bold focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                        <span class="text-[10px] font-bold text-slate-400 shrink-0">회</span>
                    </div>
                    <button type="button" onclick="addDropSetInput(this)" class="px-2 py-1.5 bg-amber-50 text-amber-700 hover:bg-amber-100 border border-amber-200 text-[11px] font-bold rounded-xl shrink-0 btn-active" title="드롭세트 추가">
                        +드롭
                    </button>
                    <button type="button" onclick="removeSetRow(this)" class="text-slate-300 hover:text-rose-500 p-1.5 text-xs btn-active shrink-0">
                        <i class="fa-solid fa-trash-can"></i>
                    </button>
                </div>
                <div class="drop-sets-container space-y-1.5 pl-10"></div>
            `;
            container.appendChild(row);

            if (drops && Array.isArray(drops)) {
                const dropContainer = row.querySelector('.drop-sets-container');
                drops.forEach(d => appendDropSetElement(dropContainer, d.weight, d.reps));
            }

            updateSetNumbers();
            calculateRealtimeStats();
        }

        function removeSetRow(btn) {
            const row = btn.closest('.set-row');
            row.remove();
            updateSetNumbers();
            calculateRealtimeStats();
        }

        function updateSetNumbers() {
            const rows = document.querySelectorAll('#sets-container .set-row');
            rows.forEach((row, idx) => {
                row.querySelector('.set-num').textContent = `${idx + 1}세트`;
            });
        }

        function addDropSetInput(btn) {
            const row = btn.closest('.set-row');
            const dropContainer = row.querySelector('.drop-sets-container');
            appendDropSetElement(dropContainer);
        }

        function appendDropSetElement(container, weight = '', reps = '') {
            const dropRow = document.createElement('div');
            dropRow.className = 'drop-set-item flex items-center space-x-1.5 bg-amber-50/70 p-1.5 rounded-xl border border-amber-200/80';
            dropRow.innerHTML = `
                <span class="text-[10px] font-bold text-amber-700 shrink-0">↳ 드롭</span>
                <input type="number" step="0.5" placeholder="무게" value="${weight}" oninput="calculateRealtimeStats()" class="drop-weight w-full bg-white border border-amber-200 rounded-lg px-2 py-1 text-xs text-center font-bold text-slate-800 focus:outline-none">
                <span class="text-[9px] text-slate-400 shrink-0">kg</span>
                <input type="number" placeholder="횟수" value="${reps}" oninput="calculateRealtimeStats()" class="drop-reps w-full bg-white border border-amber-200 rounded-lg px-2 py-1 text-xs text-center font-bold text-slate-800 focus:outline-none">
                <span class="text-[9px] text-slate-400 shrink-0">회</span>
                <button type="button" onclick="this.parentElement.remove(); calculateRealtimeStats();" class="text-slate-300 hover:text-rose-500 px-1"><i class="fa-solid fa-xmark text-xs"></i></button>
            `;
            container.appendChild(dropRow);
            calculateRealtimeStats();
        }

        function copyFirstSetToAll() {
            const container = document.getElementById('sets-container');
            if (container.children.length === 0) return;
            const firstRow = container.children[0];
            const w = firstRow.querySelector('.set-weight').value;
            const r = firstRow.querySelector('.set-reps').value;

            const rows = container.querySelectorAll('.set-row');
            for (let i = 1; i < rows.length; i++) {
                rows[i].querySelector('.set-weight').value = w;
                rows[i].querySelector('.set-reps').value = r;
            }
            calculateRealtimeStats();
        }

        function loadLastRecordSets() {
            const exercise = document.getElementById('input-exercise').value;
            const history = allLogs.filter(l => l.exercise === exercise);
            if (history.length > 0) {
                const last = history[0];
                const container = document.getElementById('sets-container');
                container.innerHTML = '';
                last.sets.forEach(s => {
                    addSetRow(s.weight, s.reps, s.drops);
                });
            } else {
                alert('해당 종목의 이전 기록이 존재하지 않습니다.');
            }
        }

        // Stats & Coaching Logic
        function calculateRealtimeStats() {
            const rows = document.querySelectorAll('#sets-container .set-row');

            let totalVolume = 0;
            let maxWeight = 0;
            let maxReps = 0;

            rows.forEach(r => {
                const w = parseFloat(r.querySelector('.set-weight').value) || 0;
                const rep = parseFloat(r.querySelector('.set-reps').value) || 0;
                totalVolume += (w * rep);

                if (w > maxWeight) {
                    maxWeight = w;
                    maxReps = rep;
                }

                r.querySelectorAll('.drop-set-item').forEach(d => {
                    const dw = parseFloat(d.querySelector('.drop-weight').value) || 0;
                    const drep = parseFloat(d.querySelector('.drop-reps').value) || 0;
                    totalVolume += (dw * drep);
                });
            });

            const estimated1RM = maxWeight > 0 ? Math.round(maxWeight * (1 + maxReps / 30)) : 0;

            document.getElementById('stat-total-volume').textContent = `${totalVolume.toLocaleString()} kg`;
            document.getElementById('stat-estimated-1rm').textContent = `${estimated1RM.toLocaleString()} kg`;
        }

        function calculateCoachingTip() {
            const exercise = document.getElementById('input-exercise').value;
            const history = allLogs.filter(l => l.exercise === exercise);

            const tipBox = document.getElementById('coaching-tip-box');
            const tipTitle = document.getElementById('coaching-tip-title');
            const tipDesc = document.getElementById('coaching-tip-desc');

            if (history.length === 0) {
                tipBox.classList.add('hidden');
                return;
            }

            tipBox.classList.remove('hidden');
            const lastLog = history[0];
            const maxWeight = Math.max(...lastLog.sets.map(s => s.weight || 0));
            const maxReps = Math.max(...lastLog.sets.map(s => s.reps || 0));

            if (maxReps >= 12) {
                tipTitle.textContent = "🔥 증량 도전 추천!";
                tipDesc.textContent = `지난 수행에서 ${maxWeight}kg으로 ${maxReps}회를 성공했습니다. 다음 세트에 +2.5kg 증량을 도전해보세요!`;
            } else if (history.length >= 3 && history[0].sets[0]?.weight === history[1].sets[0]?.weight && history[1].sets[0]?.weight === history[2].sets[0]?.weight) {
                tipTitle.textContent = "🚨 3회 연속 무게 정체 경고";
                tipDesc.textContent = "최근 3회 연속 같은 무게입니다. 횟수를 +2회 늘리거나 드롭세트를 활용해 점진적 과부하를 이어가세요.";
            } else {
                tipTitle.textContent = "💪 점진적 과부하 수행 중";
                tipDesc.textContent = `지난 기록: ${maxWeight}kg × ${maxReps}회. 동일 무게에서 횟수를 +1~2회 추가하는 것을 목표로 설정하세요.`;
            }
        }

        // Rest Timer Logic
        function startRestTimer(seconds) {
            clearInterval(timerInterval);
            timerSeconds = seconds;
            updateTimerDisplay();

            timerInterval = setInterval(() => {
                timerSeconds--;
                if (timerSeconds <= 0) {
                    clearInterval(timerInterval);
                    document.getElementById('timer-display').innerHTML = `00:00 <span class="text-xs font-bold bg-emerald-500/20 text-emerald-300 px-1.5 py-0.5 rounded-lg border border-emerald-400/30 ml-1">완료!</span>`;
                } else {
                    updateTimerDisplay();
                }
            }, 1000);
        }

        function resetRestTimer() {
            clearInterval(timerInterval);
            timerSeconds = 0;
            document.getElementById('timer-display').textContent = "00:00";
        }

        function updateTimerDisplay() {
            const m = Math.floor(timerSeconds / 60).toString().padStart(2, '0');
            const s = (timerSeconds % 60).toString().padStart(2, '0');
            document.getElementById('timer-display').textContent = `${m}:${s}`;
        }

        // Save & Edit Record Logic (중복 호출 방지 버전)
        function saveRecord() {
            const date = document.getElementById('input-date').value;
            const exercise = document.getElementById('input-exercise').value;
            const memo = document.getElementById('input-memo').value;

            const rows = document.querySelectorAll('#sets-container .set-row');
            const sets = [];

            rows.forEach(r => {
                const w = parseFloat(r.querySelector('.set-weight').value);
                const rep = parseInt(r.querySelector('.set-reps').value);

                if (!isNaN(w) && !isNaN(rep)) {
                    const dropsData = [];
                    r.querySelectorAll('.drop-set-item').forEach(d => {
                        const dw = parseFloat(d.querySelector('.drop-weight').value);
                        const drep = parseInt(d.querySelector('.drop-reps').value);
                        if (!isNaN(dw) && !isNaN(drep)) {
                            dropsData.push({ weight: dw, reps: drep });
                        }
                    });

                    const setObj = { weight: w, reps: rep };
                    if (dropsData.length > 0) setObj.drops = dropsData;
                    sets.push(setObj);
                }
            });

            if (sets.length === 0) {
                alert('최소 1개 이상의 세트 무게와 횟수를 입력해 주세요.');
                return;
            }

            const recordData = {
                id: editingLogId,
                date: date,
                routine: currentRoutine,
                exercise: exercise,
                sets: sets,
                memo: memo
            };

            showLoading(true);

            if (typeof google !== 'undefined' && google.script && google.script.run) {
                const runner = google.script.run
                    .withSuccessHandler(res => {
                        showLoading(false);
                        alert(editingLogId ? '운동 일지가 성공적으로 수정되었습니다!' : '운동 일지가 성공적으로 저장되었습니다!');
                        cancelEditMode();
                        fetchLogs();
                        switchTab('list');
                    })
                    .withFailureHandler(err => {
                        showLoading(false);
                        alert('저장 실패: ' + err.message);
                    });

                if (editingLogId) {
                    runner.updateLog(recordData);
                } else {
                    runner.addLog(recordData);
                }
            } else {
                setTimeout(() => {
                    showLoading(false);
                    if (editingLogId) {
                        const idx = allLogs.findIndex(l => l.id === editingLogId);
                        if (idx !== -1) {
                            allLogs[idx] = { ...allLogs[idx], ...recordData };
                        }
                        alert('운동 일지가 성공적으로 수정되었습니다!');
                    } else {
                        const newLog = {
                            id: 'LOG_LOCAL_' + Date.now(),
                            ...recordData,
                            createdAt: new Date().toISOString().replace('T', ' ').substring(0, 19)
                        };
                        allLogs.unshift(newLog);
                        alert('운동 일지가 성공적으로 저장되었습니다!');
                    }
                    cancelEditMode();
                    switchTab('list');
                }, 400);
            }
        }

        // Edit Mode Functions
        function editRecord(id) {
            const log = allLogs.find(l => l.id === id);
            if (!log) return;

            editingLogId = log.id;
            document.getElementById('input-date').value = log.date;
            selectRoutine(log.routine);
            document.getElementById('input-exercise').value = log.exercise;
            document.getElementById('input-memo').value = log.memo || '';

            const container = document.getElementById('sets-container');
            container.innerHTML = '';
            log.sets.forEach(s => {
                addSetRow(s.weight, s.reps, s.drops);
            });

            document.getElementById('form-title-text').innerHTML = `<i class="fa-solid fa-pen-to-square text-amber-600 mr-2"></i>운동 일지 수정 <span class="ml-2 text-xs text-amber-700 bg-amber-50 px-2 py-0.5 rounded-md border border-amber-200">수정 중</span>`;
            
            const btnContainer = document.getElementById('form-btn-container');
            btnContainer.innerHTML = `
                <div class="flex space-x-2">
                    <button type="button" onclick="cancelEditMode()" class="flex-1 py-3.5 bg-slate-100 hover:bg-slate-200 text-slate-600 font-bold rounded-2xl shadow-sm text-sm btn-active">취소</button>
                    <button type="button" onclick="saveRecord()" class="flex-1 py-3.5 bg-amber-600 hover:bg-amber-700 active:bg-amber-800 text-white font-bold rounded-2xl shadow-md text-sm transition-all btn-active flex items-center justify-center">
                        <i class="fa-solid fa-check mr-2"></i>수정 완료
                    </button>
                </div>
            `;

            switchTab('input');
        }

        function cancelEditMode() {
            editingLogId = null;
            document.getElementById('form-title-text').innerHTML = `<i class="fa-solid fa-pen-to-square text-indigo-600 mr-2"></i>운동 일지 작성`;
            
            const btnContainer = document.getElementById('form-btn-container');
            btnContainer.innerHTML = `
                <button type="button" onclick="saveRecord()" id="save-btn" class="w-full py-3.5 bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white font-bold rounded-2xl shadow-md text-sm transition-all btn-active flex items-center justify-center">
                    <i class="fa-solid fa-floppy-disk mr-2"></i>운동 일지 저장하기
                </button>
            `;

            document.getElementById('input-date').value = new Date().toISOString().substring(0, 10);
            document.getElementById('input-memo').value = '';
            selectRoutine('가슴·삼두');
            const container = document.getElementById('sets-container');
            container.innerHTML = '';
            addSetRow(60, 10);
            addSetRow(60, 10);
            addSetRow(60, 8);
